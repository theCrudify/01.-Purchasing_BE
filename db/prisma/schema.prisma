}

/// BP qualification per category, with its own approval state.
model BpCategory {
  BpId       BigInt
  CategoryId Int
  Status     String    @default("PENDING") @db.VarChar(10) /// PENDING | APPROVED | REJECTED | SUSPENDED
  DecidedAt  DateTime? @db.Timestamptz(3)
  DecidedBy  BigInt?
  CreatedAt  DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy  BigInt?

  BusinessPartner BusinessPartner @relation(fields: [BpId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Category        Category        @relation(fields: [CategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Decider         User?           @relation(fields: [DecidedBy], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@id([BpId, CategoryId])
  @@index([CategoryId, Status])
