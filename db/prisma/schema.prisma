// =====================================================================
// Purchasing Portal — Integrated Business Partner, Procurement & Approval Database
// Provider : SQL Server 2019+
//
// Table prefixes
//   mst_  master & configuration (changes rarely, referenced by transactions)
//   tr_   transactions (one row per business event / document)
//   hist_ append-only history & audit (never updated)
//   sys_  technical (sessions, OTP, files, numbering)
//
// Conventions
//   - Fields PascalCase, tables snake_case via @@map (same as the old portal).
//   - Every relation is NoAction/NoAction: rows are never hard-deleted and
//     SQL Server rejects multiple cascade paths.
//   - CreatedBy/UpdatedBy are plain BigInt (log values, no FK). Business actors
//     (approver, reviewer, owner, ...) ARE foreign keys.
//   - Status columns are VarChar + CHECK constraints (SQL Server has no enum).
//   - CHECK constraints, filtered unique indexes and views live in
//     prisma/sql/constraints.sql — append it to the first migration
//     (`prisma migrate dev --create-only`, then paste, then `migrate dev`).
// =====================================================================

generator client {
  provider      = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// 1. IDENTITY & ACCESS (mst_)
// =====================================================================

/// One identity for internal staff, business-partner portal users and system accounts.
model User {
  Id              BigInt    @id @default(autoincrement())
  PublicId        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  UserType        String    @db.VarChar(10) /// INTERNAL | BP | SYSTEM
  Email           String    @unique @db.VarChar(254)
  DisplayName     String    @db.VarChar(150)
  Phone           String?   @db.VarChar(30)
  SignatureFileId BigInt? /// signature image printed on approved documents
  Status          String    @default("PENDING_ACTIVATION") @db.VarChar(20) /// PENDING_ACTIVATION | ACTIVE | LOCKED | DISABLED | REJECTED
  StatusReason    String?   @db.VarChar(500) /// e.g. registration rejection reason
  EmailVerifiedAt DateTime? @db.Timestamptz(3)
  LastLoginAt     DateTime? @db.Timestamptz(3) /// [DB] maintained by trigger — read-only for the app (from sys_user_session)
  CreatedAt       DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy       BigInt?
  UpdatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy       BigInt?

  Roles                 UserRole[]
  Employee              Employee?
  BpMemberships         BpUser[]
  BpPicAssignments      BpInternalPic[]
  Sessions              UserSession[]
  UploadedFiles         StoredFile[]
  HeadOfDepartments     Department[]
  VerifiedBankAccounts  BpBankAccount[]
  DecidedBpCategories   BpCategory[]
  ReviewedBpDocuments   BpDocument[]
  OwnedDocuments        Document[]
  DocumentComments      DocumentComment[]
  ReviewedVerifications BpVerification[]
  VerificationChecks    BpVerificationCheck[]
  RfqInvitationsSent    RfqParticipant[]
  EvaluatedQuotations   Quotation[]
  AcknowledgedPOs       PurchaseOrder[]
  ReceivedGoods         GoodsReceipt[]
  TemplateSteps         ApprovalTemplateStep[]
  AssignedTasks         ApprovalTask[]          @relation("TaskAssignee")
  ActedTasks            ApprovalTask[]          @relation("TaskActedBy")
  DelegationsGiven      ApprovalDelegation[]    @relation("DelegationFrom")
  DelegationsReceived   ApprovalDelegation[]    @relation("DelegationTo")
  Notifications         Notification[]
  DocumentStatusActs    DocumentStatusHistory[]
  BpStatusActs          BpStatusHistory[]
  Activities            UserActivity[]

  PreparerMappings ApproverMapping[] @relation("MappingPreparer")
  ApproverMappings ApproverMapping[] @relation("MappingApprover")

  HandoversFrom UserHandover[] @relation("HandoverFrom")
  HandoversTo   UserHandover[] @relation("HandoverTo")

  ReassignmentsFrom      ApprovalReassignment[] @relation("ReassignFrom")
  ReassignmentsTo        ApprovalReassignment[] @relation("ReassignTo")
  ReassignmentsRequested ApprovalReassignment[] @relation("ReassignRequestedBy")
  ReassignmentsToApprove ApprovalReassignment[] @relation("ReassignApprover")

  Credential        UserCredential?
  InvoicesToReceive ApInvoice[]      @relation("InvoiceReceiver")
  BackupFor         ApprovalBackup[] @relation("BackupApprover")
  BackupAs          ApprovalBackup[] @relation("BackupUser")

  ApproverPicks DocumentApproverPick[]
  FormNotes     FormNote[]
  SignatureFile StoredFile?            @relation("UserSignature", fields: [SignatureFileId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([Id, UserType]) // target of typed FKs (Employee, BpUser, BpInternalPic)
  @@index([UserType, Status])
  @@map("mst_user")
}

/// Login secrets and lockout state, separated from the profile so that no portal
/// query (mst_user is readable for display names) can ever reach a password hash.
/// Read and written only by the authentication service on the internal connection.
model UserCredential {
  UserId            BigInt    @id
  AuthProvider      String    @default("LOCAL") @db.VarChar(20) /// LOCAL | ENTRA_ID (old value MICROSOFT → ENTRA_ID)
  ExternalAuthId    String?   @db.VarChar(200) /// Entra object id, bound on first SSO login
  PasswordHash      String?   @db.VarChar(255) /// required for LOCAL
  PasswordChangedAt DateTime? @db.Timestamptz(3)
  FailedLoginCount  Int       @default(0) @db.SmallInt
  LockoutCount      Int       @default(0) @db.SmallInt /// escalating lockout: 15 + 5×(n−1) minutes, suspended after 5 cycles
  LockoutUntil      DateTime? @db.Timestamptz(3)
  UpdatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  User User @relation(fields: [UserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sys_user_credential")
}

model Role {
  Id          Int       @id @default(autoincrement())
  Code        String    @unique @db.VarChar(50)
  Name        String    @db.VarChar(100)
  Scope       String    @db.VarChar(10) /// INTERNAL | BP | SYSTEM
  Description String?   @db.VarChar(255)
  IsActive    Boolean   @default(true)
  IsDeleted   Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt   DateTime? @db.Timestamptz(3)
  DeletedBy   BigInt?
  CreatedAt   DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy   BigInt?
  UpdatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy   BigInt?

  Users         UserRole[]
  Permissions   RolePermission[]
  TemplateSteps ApprovalTemplateStep[]

  @@map("mst_role")
}

model Permission {
  Id     Int    @id @default(autoincrement())
  Code   String @unique @db.VarChar(80) /// e.g. PO.CREATE, PO.APPROVE, BP.VERIFY
  Module String @db.VarChar(30)
  Name   String @db.VarChar(150)

  Roles RolePermission[]

  @@map("mst_permission")
}

model RolePermission {
  RoleId       Int
  PermissionId Int
  CreatedAt    DateTime @default(now()) @db.Timestamptz(3)
  CreatedBy    BigInt?

  Role       Role       @relation(fields: [RoleId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Permission Permission @relation(fields: [PermissionId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@id([RoleId, PermissionId])
  @@index([PermissionId])
  @@map("mst_role_permission")
}

model UserRole {
  UserId    BigInt
  RoleId    Int
  CreatedAt DateTime @default(now()) @db.Timestamptz(3)
  CreatedBy BigInt?

  User User @relation(fields: [UserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Role Role @relation(fields: [RoleId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@id([UserId, RoleId])
  @@index([RoleId])
  @@map("mst_user_role")
}

// =====================================================================
// 2. INTERNAL ORGANISATION (mst_)
// =====================================================================

model Department {
  Id         Int       @id @default(autoincrement())
  Code       String    @unique @db.VarChar(20)
  Name       String    @db.VarChar(150)
  ParentId   Int?
  HeadUserId BigInt?
  IsActive   Boolean   @default(true)
  IsDeleted  Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt  DateTime? @db.Timestamptz(3)
  DeletedBy  BigInt?
  CreatedAt  DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy  BigInt?
  UpdatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy  BigInt?

  Parent   Department?  @relation("DepartmentTree", fields: [ParentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Children Department[] @relation("DepartmentTree")
  HeadUser User?        @relation(fields: [HeadUserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  CostCenters       CostCenter[]
  Employees         Employee[]
  Documents         Document[]
  ApprovalTemplates ApprovalTemplate[]

  ExpenseAccounts ExpenseAccount[]
  Budgets         Budget[]

  @@index([ParentId])
  @@map("mst_department")
}

model CostCenter {
  Id           Int       @id @default(autoincrement())
  Code         String    @unique @db.VarChar(20)
  Name         String    @db.VarChar(150)
  DepartmentId Int?
  IsActive     Boolean   @default(true)
  IsDeleted    Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt    DateTime? @db.Timestamptz(3)
  DeletedBy    BigInt?
  CreatedAt    DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy    BigInt?
  UpdatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy    BigInt?

  Department         Department?           @relation(fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PurchaseRequests   PurchaseRequest[]
  PurchaseReqLines   PurchaseRequestLine[]
  PurchaseOrderLines PurchaseOrderLine[]

  ExpenseLines   ExpenseLine[]
  ApInvoiceLines ApInvoiceLine[]
  ArInvoiceLines ArInvoiceLine[]
  JournalLines   JournalLine[]

  PaymentLines PaymentLine[]

  @@index([DepartmentId])
  @@map("mst_cost_center")
}

/// 1:1 extension of an INTERNAL user. SuperiorUserId replaces ApproverBackup and
/// EmployeeSuperiorDocumentApprovals.
model Employee {
  UserId         BigInt    @id
  UserType       String    @default("INTERNAL") @db.VarChar(10) /// always INTERNAL (CHECK)
  EmployeeNo     String    @unique @db.VarChar(30) /// NIK, normalised
  DepartmentId   Int
  JobTitle       String?   @db.VarChar(100)
  SuperiorUserId BigInt?
  JoinDate       DateTime? @db.Date
  EndDate        DateTime? @db.Date /// last working day (may be in the future during notice period)
  EndReason      String?   @db.VarChar(15) /// RESIGNED | TERMINATED | RETIRED | TRANSFERRED | DECEASED
  IsActive       Boolean   @default(true)
  CreatedAt      DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy      BigInt?
  UpdatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy      BigInt?

  User         User       @relation(fields: [UserId, UserType], references: [Id, UserType], onDelete: NoAction, onUpdate: NoAction)
  Department   Department @relation(fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Superior     Employee?  @relation("EmployeeSuperior", fields: [SuperiorUserId], references: [UserId], onDelete: NoAction, onUpdate: NoAction)
  Subordinates Employee[] @relation("EmployeeSuperior")

  CashAdvances   CashAdvance[]
  Reimbursements Reimbursement[]
  BankAccounts   EmployeeBankAccount[]
  Receipts       Receipt[]
  JournalLines   JournalLine[]

  @@unique([UserId, UserType])
  @@index([DepartmentId])
  @@index([SuperiorUserId])
  @@map("mst_employee")
}

// =====================================================================
// 3. GENERAL MASTER DATA (mst_)
// =====================================================================

/// ISO 4217 currencies (all of them, seeded from the official SIX list — sql/seed_currency.sql).
/// Base / functional currency of Purchasing Portal is IDR.
model Currency {
  Code        String  @id @db.Char(3) /// ISO 4217 alpha, e.g. IDR
  NumericCode String  @unique @db.Char(3) /// ISO 4217 numeric, e.g. 360
  Name        String  @db.VarChar(100)
  Symbol      String? @db.VarChar(10) /// display only, e.g. Rp, $, ¥
  Decimals    Int     @default(2) @db.SmallInt /// ISO minor units (JPY 0, IDR 2, KWD 3)
  IsFund      Boolean @default(false) /// fund / metal / special codes (XAU, XDR, BOV…) — not for documents
  IsActive    Boolean @default(false) /// enabled for transactions by Finance

  Rates            ExchangeRate[]
  BusinessPartners BusinessPartner[]
  BankAccounts     BpBankAccount[]
  Documents        Document[]

  EmployeeBankAccounts  EmployeeBankAccount[]
  CompanyBankAccounts   CompanyBankAccount[]
  JournalLines          JournalLine[]
  FxRevaluationLines    FxRevaluationLine[]
  AccountDeterminations AccountDetermination[]
  LandedCosts           LandedCost[]

  @@map("mst_currency")
}

/// Rate history: 1 unit of CurrencyCode = RateToBase IDR. Rows are never overwritten silently —
/// every UPDATE/DELETE is copied to hist_audit_log by trigger. A document keeps the rate it was
/// created with, so later rate changes never alter existing documents.
model ExchangeRate {
  CurrencyCode String   @db.Char(3)
  RateType     String   @db.VarChar(10) /// MIDDLE (kurs tengah BI — accounting) | TAX (kurs KMK — PPN/PPh) | BANK (actual bank rate)
  RateDate     DateTime @db.Date /// valid from this date until the next row of the same type
  RateToBase   Decimal  @db.Decimal(18, 6) /// per 1 unit (convert BI "per 100 JPY" quotes on input)
  Source       String   @default("MANUAL") @db.VarChar(20) /// BI | KMK | BANK | MANUAL
  CreatedAt    DateTime @default(now()) @db.Timestamptz(3)
  CreatedBy    BigInt?

  Currency Currency @relation(fields: [CurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)

  @@id([CurrencyCode, RateType, RateDate])
  @@map("mst_exchange_rate")
}

/// VAT (PPN) and withholding tax (PPh) in one table — replaces mst_vat + mst_withholding_tax_rate.
model TaxCode {
  Id            Int       @id @default(autoincrement())
  Code          String    @unique @db.VarChar(20)
  Name          String    @db.VarChar(100)
  TaxType       String    @db.VarChar(3) /// VAT | WHT
  RatePercent   Decimal   @db.Decimal(7, 4)
  EffectiveFrom DateTime  @db.Date
  EffectiveTo   DateTime? @db.Date
  IsActive      Boolean   @default(true)
  IsDeleted     Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt     DateTime? @db.Timestamptz(3)
  DeletedBy     BigInt?
  CreatedAt     DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy     BigInt?
  UpdatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy     BigInt?

  Items              Item[]
  QuotationLines     QuotationLine[]
  PurchaseOrderLines PurchaseOrderLine[]
  InvoicesVat        ApInvoice[]         @relation("InvoiceVat")
  InvoicesWht        ApInvoice[]         @relation("InvoiceWht")

  ArInvoicesVat  ArInvoice[]     @relation("ArInvoiceVat")
  ArInvoicesWht  ArInvoice[]     @relation("ArInvoiceWht")
  ArInvoiceLines ArInvoiceLine[]

  BpDefaultVat          BusinessPartner[]      @relation("BpDefaultVat")
  BpDefaultWht          BusinessPartner[]      @relation("BpDefaultWht")
  ApInvoiceLinesVat     ApInvoiceLine[]        @relation("ApInvoiceLineVat")
  ApInvoiceLinesWht     ApInvoiceLine[]        @relation("ApInvoiceLineWht")
  AccountDeterminations AccountDetermination[]
  ContractLines         PurchaseContractLine[]

  @@index([TaxType, IsActive])
  @@map("mst_tax_code")
}

model PaymentTerm {
  Id           Int       @id @default(autoincrement())
  Code         String    @unique @db.VarChar(20)
  Name         String    @db.VarChar(100)
  DueDays      Int       @db.SmallInt
  BaselineDate String    @default("INVOICE_DATE") @db.VarChar(15) /// INVOICE_DATE | RECEIPT_DATE
  IsActive     Boolean   @default(true)
  IsDeleted    Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt    DateTime? @db.Timestamptz(3)
  DeletedBy    BigInt?

  BusinessPartners BusinessPartner[]
  Quotations       Quotation[]
  PurchaseOrders   PurchaseOrder[]

  ArInvoices        ArInvoice[]
  PurchaseContracts PurchaseContract[]

  @@map("mst_payment_term")
}

model Uom {
  Id        Int       @id @default(autoincrement())
  Code      String    @unique @db.VarChar(10)
  Name      String    @db.VarChar(50)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?

  Items              Item[]
  PurchaseReqLines   PurchaseRequestLine[]
  RfqLines           RfqLine[]
  PurchaseOrderLines PurchaseOrderLine[]

  ArInvoiceLines ArInvoiceLine[]

  ItemsPurchase    Item[]                 @relation("ItemPurchaseUom")
  PrLinesInventory PurchaseRequestLine[]  @relation("PrLineInventoryUom")
  PoLinesInventory PurchaseOrderLine[]    @relation("PoLineInventoryUom")
  ContractLines    PurchaseContractLine[]

  @@map("mst_uom")
}

/// One tree for items, PR lines and BP qualification ("which BP can supply this?").
model Category {
  Id        Int       @id @default(autoincrement())
  Code      String    @unique @db.VarChar(30)
  Name      String    @db.VarChar(150)
  ParentId  Int?
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?
  CreatedAt DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy BigInt?
  UpdatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy BigInt?

  Parent                Category?              @relation("CategoryTree", fields: [ParentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Children              Category[]             @relation("CategoryTree")
  Items                 Item[]
  BpCategories          BpCategory[]
  PurchaseReqLines      PurchaseRequestLine[]
  RfqLines              RfqLine[]
  AccountDeterminations AccountDetermination[]
  ContractLines         PurchaseContractLine[]

  @@index([ParentId])
  @@map("mst_category")
}

/// RM Import, RM Local, Consumable, Service, Safety, Fixed Asset… Drives the approval template.
/// Replaces Classifications, U_bsi_prclass and MappingApprover.TemplateName.
model PurchaseClass {
  Id                       Int       @id @default(autoincrement())
  Code                     String    @unique @db.VarChar(20)
  Name                     String    @db.VarChar(100)
  IsAsset                  Boolean   @default(false)
  InvoicePriceTolerancePct Decimal   @default(0) @db.Decimal(7, 4) /// allowed deviation of an invoice line's net unit price from the PO line's, in % (SAP price tolerance); 0 = exact
  IsActive                 Boolean   @default(true)
  IsDeleted                Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt                DateTime? @db.Timestamptz(3)
  DeletedBy                BigInt?

  PurchaseRequests      PurchaseRequest[]
  PurchaseOrders        PurchaseOrder[]
  ApprovalTemplates     ApprovalTemplate[]
  AccountDeterminations AccountDetermination[]
  PurchaseContracts     PurchaseContract[]
  Budgets               Budget[]

  @@map("mst_purchase_class")
}

model Item {
  Id            BigInt    @id @default(autoincrement())
  Code          String    @unique @db.VarChar(30)
  Name          String    @db.VarChar(200)
  Description   String?   @db.VarChar(1000)
  ItemType      String    @db.VarChar(10) /// GOODS | SERVICE
  CategoryId    Int
  UomId         Int
  PurchaseUomId Int? /// unit used on PO (old PurchaseUom); UomId is the inventory unit
  PackSize      Decimal?  @db.Decimal(18, 6) /// inventory units per purchase unit (old QtyPack)
  VatTaxCodeId  Int?
  IsActive      Boolean   @default(true)
  IsDeleted     Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt     DateTime? @db.Timestamptz(3)
  DeletedBy     BigInt?
  CreatedAt     DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy     BigInt?
  UpdatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy     BigInt?

  Category   Category @relation(fields: [CategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Uom        Uom      @relation(fields: [UomId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  VatTaxCode TaxCode? @relation(fields: [VatTaxCodeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  PurchaseReqLines   PurchaseRequestLine[]
  RfqLines           RfqLine[]
  PurchaseOrderLines PurchaseOrderLine[]

  ArInvoiceLines ArInvoiceLine[]

  PurchaseUom   Uom?                   @relation("ItemPurchaseUom", fields: [PurchaseUomId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ContractLines PurchaseContractLine[]

  @@index([CategoryId, IsActive])
  @@index([Name])
  @@map("mst_item")
}

/// Guidance text shown on a create form (old DocumentNotes): per user, or for everyone when UserId is NULL.
model FormNote {
  Id        Int       @id @default(autoincrement())
  UserId    BigInt?
  DocType   String    @db.VarChar(3)
  Body      String    @db.VarChar(4000)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?
  CreatedAt DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy BigInt?
  UpdatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy BigInt?

  User User? @relation(fields: [UserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([DocType, UserId])
  @@map("mst_form_note")
}

/// Expense categories for CA / settlement / reimbursement lines (old mst_Categories: Transport, Medical…).
/// Separate from mst_category, which classifies items and supplier qualification.
model ExpenseCategory {
  Id        Int       @id @default(autoincrement())
  Code      String    @unique @db.VarChar(30)
  Name      String    @db.VarChar(150)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?

  ExpenseAccounts ExpenseAccount[]

  @@map("mst_expense_category")
}

/// Predefined remark texts offered in dropdowns (old mst_Remark).
model RemarkTemplate {
  Id        Int       @id @default(autoincrement())
  Module    String    @db.VarChar(5) /// CA | STL | RMB | ALL
  Text      String    @db.VarChar(300)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?

  @@map("mst_remark_template")
}

model Bank {
  Id        Int       @id @default(autoincrement())
  Code      String    @unique @db.VarChar(20)
  Name      String    @db.VarChar(150)
  SwiftCode String?   @db.VarChar(11)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?

  BankAccounts BpBankAccount[]

  EmployeeBankAccounts EmployeeBankAccount[]
  CompanyBankAccounts  CompanyBankAccount[]

  @@map("mst_bank")
}

/// Allowed status moves per document type (seeded by sql/seed_status_transition.sql).
/// The database rejects any tr_document status change not listed here. RequiredApproval ties a
/// move to the outcome of the document's latest approval round (PENDING = a round must be open).
model StatusTransition {
  DocType          String  @db.VarChar(3)
  FromStatus       String  @db.VarChar(20)
  ToStatus         String  @db.VarChar(20)
  RequiredApproval String? @db.VarChar(10) /// PENDING | APPROVED | RETURNED | REJECTED
  AllowBp          Boolean @default(false) /// a supplier / customer portal user may make this move (submit, withdraw, acknowledge); staff may make every move
  Description      String? @db.VarChar(200)

  @@id([DocType, FromStatus, ToStatus])
  @@map("mst_status_transition")
}

/// Legal documents a BP must upload: NPWP, NIB, Akta, SPPKP, rekening koran, ISO…
model BpDocumentType {
  Id            Int       @id @default(autoincrement())
  Code          String    @unique @db.VarChar(30)
  Name          String    @db.VarChar(150)
  AppliesTo     String    @default("ALL") @db.VarChar(10) /// ALL | COMPANY | INDIVIDUAL
  IsMandatory   Boolean   @default(false)
  HasExpiry     Boolean   @default(false)
  AllowMultiple Boolean   @default(false) /// e.g. SUPPORT: many live files of this type
  IsActive      Boolean   @default(true)
  IsDeleted     Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt     DateTime? @db.Timestamptz(3)
  DeletedBy     BigInt?

  Documents BpDocument[]

  @@map("mst_bp_document_type")
}

// =====================================================================
// 3b. FINANCE MASTER (mst_)
// =====================================================================

/// Chart of accounts. Replaces mst_Coa + mst_AccountName (two unlinked lists) and the
/// free-text Coa/AccountName/GLAccount copied into every old document.
model Coa {
  Id          Int       @id @default(autoincrement())
  AccountCode String    @unique @db.VarChar(20)
  AccountName String    @db.VarChar(200)
  AccountType String?   @db.VarChar(10) /// ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  ParentId    Int?
  IsPostable  Boolean   @default(true)
  IsActive    Boolean   @default(true)
  IsDeleted   Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt   DateTime? @db.Timestamptz(3)
  DeletedBy   BigInt?
  CreatedAt   DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy   BigInt?
  UpdatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy   BigInt?

  Parent              Coa?                 @relation("CoaTree", fields: [ParentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Children            Coa[]                @relation("CoaTree")
  ExpenseAccounts     ExpenseAccount[]
  ExpenseLines        ExpenseLine[]
  CompanyBankAccounts CompanyBankAccount[]
  ApInvoiceLines      ApInvoiceLine[]
  ArInvoiceLines      ArInvoiceLine[]
  JournalLines        JournalLine[]

  BpApControl   BusinessPartner[] @relation("BpApControl")
  BpArControl   BusinessPartner[] @relation("BpArControl")
  BpDownPayment BusinessPartner[] @relation("BpDownPayment")

  PaymentLines          PaymentLine[]
  TransactionTypes      TransactionType[]      @relation("TransactionTypeControl")
  AccountDeterminations AccountDetermination[]

  @@index([ParentId])
  @@index([AccountType, IsActive])
  @@map("mst_coa")
}

/// Transaction types per module (BT, EN, GC, LO, MA, ME, NRM, OT, TR…). Replaces
/// TransactionTypes + MasterTypeTransactions + the free-text TypeTransaction codes.
model TransactionType {
  Id                 Int       @id @default(autoincrement())
  Module             String    @db.VarChar(5) /// CA | STL | RMB | ALL
  Code               String    @db.VarChar(10)
  Name               String    @db.VarChar(100)
  RequiresSettlement Boolean   @default(true) /// CA must be settled (false for Personal Loan)
  RequiresClose      Boolean   @default(false) /// CA closed by Finance after repayment (Personal Loan)
  ControlCoaId       Int? /// employee-advance / control account booked for this type (old OPCA ControlAccount)
  IsActive           Boolean   @default(true)
  IsDeleted          Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt          DateTime? @db.Timestamptz(3)
  DeletedBy          BigInt?

  CashAdvances     CashAdvance[]
  Reimbursements   Reimbursement[]
  ExpenseAccounts  ExpenseAccount[]
  ApproverMappings ApproverMapping[]

  ApprovalTemplates ApprovalTemplate[]
  ControlCoa        Coa?               @relation("TransactionTypeControl", fields: [ControlCoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([Module, Code])
  @@map("mst_transaction_type")
}

/// Category → COA lookup per module / transaction type / department (old ExpensesCOA,
/// Expenses, ExpenseDepartments). NULL TransactionTypeId / DepartmentId = applies to all.
model ExpenseAccount {
  Id                Int       @id @default(autoincrement())
  Module            String    @db.VarChar(5) /// CA | STL | RMB | AP | ALL
  TransactionTypeId Int?
  DepartmentId      Int?
  ExpenseCategoryId Int
  CoaId             Int
  Remarks           String?   @db.VarChar(300)
  IsActive          Boolean   @default(true)
  IsDeleted         Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt         DateTime? @db.Timestamptz(3)
  DeletedBy         BigInt?
  CreatedAt         DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy         BigInt?
  UpdatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy         BigInt?

  TransactionType TransactionType? @relation(fields: [TransactionTypeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Department      Department?      @relation(fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Coa             Coa              @relation(fields: [CoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ExpenseLines    ExpenseLine[]

  ExpenseCategory ExpenseCategory @relation(fields: [ExpenseCategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([Module, TransactionTypeId, DepartmentId])
  @@index([CoaId])
  @@map("mst_expense_account")
}

/// Purchasing budget (SAP funds commitment, simplified): per fiscal year and department, optionally
/// per purchase class, in IDR. Commitments = live POs + approved-but-unordered PR remainders
/// (vw_budget_consumption). BLOCK rejects a PR / PO submit that exceeds it; WARN only reports.
/// shortcut: yearly budgets by DocDate year; add PeriodKey if monthly / quarterly control is needed.
model Budget {
  Id              Int       @id @default(autoincrement())
  FiscalYear      Int       @db.SmallInt
  DepartmentId    Int
  PurchaseClassId Int? /// NULL = whole department
  Amount          Decimal   @db.Decimal(19, 2) /// IDR
  ControlMode     String    @default("BLOCK") @db.VarChar(5) /// BLOCK | WARN
  Remarks         String?   @db.VarChar(300)
  IsActive        Boolean   @default(true)
  IsDeleted       Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt       DateTime? @db.Timestamptz(3)
  DeletedBy       BigInt?
  CreatedAt       DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy       BigInt?
  UpdatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy       BigInt?

  Department    Department     @relation(fields: [DepartmentId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PurchaseClass PurchaseClass? @relation(fields: [PurchaseClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([FiscalYear, DepartmentId])
  @@map("mst_budget")
}

/// Accounting periods (SAP OFPR). A journal can be POSTED only into an OPEN period, or a CLOSING
/// period by a user holding GL.POST_CLOSING. A month without a row is closed.
/// shortcut: calendar months only (PeriodKey = YYYYMM); add Start/End dates if a non-calendar fiscal year is needed.
model PostingPeriod {
  PeriodKey String    @id @db.Char(6) /// 'YYYYMM' of the journal PostingDate
  Status    String    @default("OPEN") @db.VarChar(10) /// OPEN | CLOSING (finance only, month-end adjustments) | LOCKED
  ClosedAt  DateTime? @db.Timestamptz(3)
  ClosedBy  BigInt?
  CreatedAt DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy BigInt?
  UpdatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy BigInt?

  @@map("mst_posting_period")
}

/// G/L account determination (SAP OACT / OBYC): which COA the posting service books for each
/// account role. Optional filters narrow a rule; NULL = any. The most specific active rule wins
/// (see dbo.fn_account_for). BP-level control accounts (mst_business_partner.ApControlCoaId …)
/// override AP_CONTROL / AR_CONTROL / DOWN_PAYMENT_* for that partner.
model AccountDetermination {
  Id              Int       @id @default(autoincrement())
  AccountRole     String    @db.VarChar(20) /// GRIR_CLEARING | INVENTORY | EXPENSE | FIXED_ASSET | REVENUE | VAT_INPUT | VAT_OUTPUT | WHT_PAYABLE | WHT_PREPAID | AP_CONTROL | AR_CONTROL | DOWN_PAYMENT_AP | DOWN_PAYMENT_AR | EMPLOYEE_ADVANCE | CASH_DISCOUNT | FX_GAIN_REALIZED | FX_LOSS_REALIZED | FX_GAIN_UNREALIZED | FX_LOSS_UNREALIZED | ROUNDING
  TaxCodeId       Int? /// VAT_* / WHT_* roles only
  CategoryId      Int? /// item category (exact match; parent categories are not searched)
  PurchaseClassId Int?
  CurrencyCode    String?   @db.Char(3)
  CoaId           Int /// must be an active, postable account
  Remarks         String?   @db.VarChar(300)
  IsActive        Boolean   @default(true)
  IsDeleted       Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt       DateTime? @db.Timestamptz(3)
  DeletedBy       BigInt?
  CreatedAt       DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy       BigInt?
  UpdatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy       BigInt?

  TaxCode       TaxCode?       @relation(fields: [TaxCodeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Category      Category?      @relation(fields: [CategoryId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PurchaseClass PurchaseClass? @relation(fields: [PurchaseClassId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Currency      Currency?      @relation(fields: [CurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)
  Coa           Coa            @relation(fields: [CoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([AccountRole, IsActive])
  @@index([CoaId])
  @@map("mst_account_determination")
}

/// Company's own bank accounts (old hard-coded TrsfrAcct list: Mizuho, MUFG, CIMB in IDR/USD/JPY).
model CompanyBankAccount {
  Id           Int       @id @default(autoincrement())
  Code         String    @unique @db.VarChar(20)
  AccountKind  String    @default("BANK") @db.VarChar(5) /// BANK | CASH (cash on hand / petty cash)
  BankId       Int?
  AccountNo    String?   @db.VarChar(34)
  AccountName  String    @db.VarChar(150)
  CurrencyCode String    @db.Char(3)
  CoaId        Int /// GL account of this bank
  IsActive     Boolean   @default(true)
  IsDeleted    Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt    DateTime? @db.Timestamptz(3)
  DeletedBy    BigInt?

  Bank       Bank?       @relation(fields: [BankId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Currency   Currency    @relation(fields: [CurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)
  Coa        Coa         @relation(fields: [CoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Payments   Payment[]
  Receipts   Receipt[]
  ArInvoices ArInvoice[]

  @@map("mst_company_bank_account")
}

/// Employee payout accounts for cash advance / reimbursement transfers.
model EmployeeBankAccount {
  Id                 BigInt    @id @default(autoincrement())
  PublicId           String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid /// use in URLs, never Id
  EmployeeUserId     BigInt
  BankId             Int
  AccountNo          String    @db.VarChar(34)
  AccountHolderName  String    @db.VarChar(150)
  CurrencyCode       String    @default("IDR") @db.Char(3)
  VerificationStatus String    @default("PENDING") @db.VarChar(10) /// PENDING | VERIFIED | REJECTED
  VerifiedAt         DateTime? @db.Timestamptz(3)
  VerifiedBy         BigInt?
  IsPrimary          Boolean   @default(false)
  IsActive           Boolean   @default(true)
  IsDeleted          Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt          DateTime? @db.Timestamptz(3)
  DeletedBy          BigInt?
  CreatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy          BigInt?
  UpdatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy          BigInt?

  Employee Employee  @relation(fields: [EmployeeUserId], references: [UserId], onDelete: NoAction, onUpdate: NoAction)
  Bank     Bank      @relation(fields: [BankId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Currency Currency  @relation(fields: [CurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)
  Payments Payment[]

  @@unique([EmployeeUserId, BankId, AccountNo])
  @@map("mst_employee_bank_account")
}

/// Approver per preparer, document type, transaction type and step (old
/// EmployeeSuperiorDocumentApprovals). Used by template steps of type PREPARER_MAPPING.
/// NULL TransactionTypeId = ALL.
model ApproverMapping {
  Id                Int       @id @default(autoincrement())
  PreparerUserId    BigInt
  DocType           String    @db.VarChar(3)
  TransactionTypeId Int?
  PaymentPurpose    String?   @db.VarChar(20) /// PAY only (old OP / OPCA / POAPNEW)
  StepCode          String    @db.VarChar(5) /// CH | AC | AP | RE | CL
  ApproverUserId    BigInt
  IsActive          Boolean   @default(true)
  IsDeleted         Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt         DateTime? @db.Timestamptz(3)
  DeletedBy         BigInt?
  CreatedAt         DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy         BigInt?
  UpdatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy         BigInt?

  Preparer        User             @relation("MappingPreparer", fields: [PreparerUserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Approver        User             @relation("MappingApprover", fields: [ApproverUserId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  TransactionType TransactionType? @relation(fields: [TransactionTypeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([PreparerUserId, DocType, TransactionTypeId, PaymentPurpose, StepCode, ApproverUserId])
  @@index([ApproverUserId])
  @@map("mst_approver_mapping")
}

// =====================================================================
// 4. BUSINESS PARTNER MASTER (mst_bp_*)
// =====================================================================

/// One row per legal entity (unique NPWP). A BP can be supplier, customer, or both.
model BusinessPartner {
  Id                  BigInt    @id @default(autoincrement())
  PublicId            String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  BpCode              String?   @db.VarChar(20) /// assigned on first approval (filtered unique)
  IsSupplier          Boolean   @default(false)
  IsCustomer          Boolean   @default(false)
  EntityType          String    @db.VarChar(10) /// COMPANY (Badan) | INDIVIDUAL
  LegalName           String    @db.VarChar(200)
  TradeName           String?   @db.VarChar(200)
  TaxId               String?   @db.VarChar(20) /// NPWP digits only (filtered unique)
  BusinessRegNo       String?   @db.VarChar(20) /// NIB
  IsVatRegistered     Boolean   @default(false) /// PKP
  CountryCode         String    @default("ID") @db.Char(2)
  Email               String?   @db.VarChar(254) /// required for self-registered partners (CHECK)
  Phone               String?   @db.VarChar(30)
  Fax                 String?   @db.VarChar(30)
  GroupName           String?   @db.VarChar(100) /// old VendorGroup / BP group
  Website             String?   @db.VarChar(200)
  DefaultCurrencyCode String    @default("IDR") @db.Char(3)
  PaymentTermId       Int?
  ApControlCoaId      Int? /// payable control account (old MainPayableAccount)
  ArControlCoaId      Int? /// receivable control account (customers)
  DownPaymentCoaId    Int? /// down-payment account (old DPAccount)
  DefaultVatTaxCodeId Int? /// old TaxCode
  DefaultWhtTaxCodeId Int?
  OnboardingStatus    String    @default("DRAFT") @db.VarChar(20) /// DRAFT | SUBMITTED | REVISION_REQUIRED | APPROVED | REJECTED
  OperationalStatus   String    @default("INACTIVE") @db.VarChar(15) /// INACTIVE | ACTIVE | SUSPENDED | BLACKLISTED
  OperationalReason   String?   @db.VarChar(500)
  IsDeleted           Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt           DateTime? @db.Timestamptz(3)
  DeletedBy           BigInt?
  FirstApprovedAt     DateTime? @db.Timestamptz(3)
  Source              String    @default("SELF_REGISTERED") @db.VarChar(15) /// SELF_REGISTERED | INTERNAL | MIGRATED
  LegacyCode          String?   @db.VarChar(30) /// old SAP CardCode / portal VendorCode — traceability only
  Version             Int       @default(0) /// optimistic concurrency
  CreatedAt           DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy           BigInt?
  UpdatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy           BigInt?

  DefaultCurrency Currency     @relation(fields: [DefaultCurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)
  PaymentTerm     PaymentTerm? @relation(fields: [PaymentTermId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  Addresses          BpAddress[]
  Contacts           BpContact[]
  BankAccounts       BpBankAccount[]
  Categories         BpCategory[]
  Users              BpUser[]
  InternalPics       BpInternalPic[]
  LegalDocuments     BpDocument[]
  StatusHistory      BpStatusHistory[]
  Documents          Document[]
  RfqParticipations  RfqParticipant[]
  SuggestedInPrLines PurchaseRequestLine[]
  Invoices           ApInvoice[]

  JournalLines JournalLine[]

  ApControlCoa      Coa?     @relation("BpApControl", fields: [ApControlCoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  ArControlCoa      Coa?     @relation("BpArControl", fields: [ArControlCoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  DownPaymentCoa    Coa?     @relation("BpDownPayment", fields: [DownPaymentCoaId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  DefaultVatTaxCode TaxCode? @relation("BpDefaultVat", fields: [DefaultVatTaxCodeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  DefaultWhtTaxCode TaxCode? @relation("BpDefaultWht", fields: [DefaultWhtTaxCodeId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([OnboardingStatus, OperationalStatus])
  @@index([LegalName])
  @@index([IsSupplier, OperationalStatus])
  @@map("mst_business_partner")
}

model BpAddress {
  Id          BigInt    @id @default(autoincrement())
  PublicId    String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid /// use in URLs, never Id
  BpId        BigInt
  AddressType String    @db.VarChar(10) /// HQ | BILLING | SHIPPING | BRANCH
  Line1       String    @db.VarChar(200)
  Line2       String?   @db.VarChar(200)
  City        String    @db.VarChar(100)
  Province    String?   @db.VarChar(100)
  PostalCode  String?   @db.VarChar(10)
  CountryCode String    @default("ID") @db.Char(2)
  IsPrimary   Boolean   @default(false)
  IsActive    Boolean   @default(true)
  IsDeleted   Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt   DateTime? @db.Timestamptz(3)
  DeletedBy   BigInt?
  CreatedAt   DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy   BigInt?
  UpdatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy   BigInt?

  BusinessPartner BusinessPartner @relation(fields: [BpId], references: [Id], onDelete: NoAction, onUpdate: NoAction)

  @@index([BpId])
  @@map("mst_bp_address")
}

model BpContact {
  Id        BigInt    @id @default(autoincrement())
  PublicId  String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid /// use in URLs, never Id
  BpId      BigInt
  Name      String    @db.VarChar(150)
  Position  String?   @db.VarChar(100)
  Email     String?   @db.VarChar(254)
  Phone     String?   @db.VarChar(30)
  IsPrimary Boolean   @default(false)
  IsActive  Boolean   @default(true)
  IsDeleted Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt DateTime? @db.Timestamptz(3)
  DeletedBy BigInt?
  CreatedAt DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy BigInt?
  UpdatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy BigInt?

  BusinessPartner BusinessPartner @relation(fields: [BpId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  PurchaseOrders  PurchaseOrder[]

  @@index([BpId])
  @@map("mst_bp_contact")
}

/// A new or changed account is unusable for payment until VERIFIED (anti-fraud).
model BpBankAccount {
  Id                 BigInt    @id @default(autoincrement())
  PublicId           String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid /// use in URLs, never Id
  BpId               BigInt
  BankId             Int
  AccountNo          String    @db.VarChar(34)
  AccountHolderName  String    @db.VarChar(150)
  BranchName         String?   @db.VarChar(100)
  CurrencyCode       String    @default("IDR") @db.Char(3)
  ProofFileId        BigInt?
  VerificationStatus String    @default("PENDING") @db.VarChar(10) /// PENDING | VERIFIED | REJECTED
  VerifiedAt         DateTime? @db.Timestamptz(3)
  VerifiedBy         BigInt?
  IsPrimary          Boolean   @default(false)
  IsActive           Boolean   @default(true)
  IsDeleted          Boolean   @default(false) /// soft delete: hidden from normal lists, visible on the restricted "deleted" page
  DeletedAt          DateTime? @db.Timestamptz(3)
  DeletedBy          BigInt?
  CreatedAt          DateTime  @default(now()) @db.Timestamptz(3)
  CreatedBy          BigInt?
  UpdatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
  UpdatedBy          BigInt?

  BusinessPartner BusinessPartner @relation(fields: [BpId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Bank            Bank            @relation(fields: [BankId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Currency        Currency        @relation(fields: [CurrencyCode], references: [Code], onDelete: NoAction, onUpdate: NoAction)
  ProofFile       StoredFile?     @relation(fields: [ProofFileId], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Verifier        User?           @relation(fields: [VerifiedBy], references: [Id], onDelete: NoAction, onUpdate: NoAction)
  Payments        Payment[]

  Iban               String? @db.VarChar(34)
  BeneficiaryAddress String? @db.VarChar(300)
  IsResident         Boolean @default(true) /// MUFG remittance profile (old UDO_Detail / BeneficiaryInformation)
  BeneficiaryType    String? @db.VarChar(10) /// INDIVIDUAL | COMPANY
  Relationship       String? @db.VarChar(50)
  RemittancePurpose  String? @db.VarChar(100)
  VirtualAccountNo   String? @db.VarChar(50)
  VirtualAccountName String? @db.VarChar(200) /// old BeneficiaryAccountVA
  BeneficiaryCountry String? @db.Char(2)
  BeneficiaryCity    String? @db.VarChar(100)
  BankAddress        String? @db.VarChar(500)
  BankCity           String? @db.VarChar(100)
  BankCountry        String? @db.Char(2)
  Citizenship        String? @db.VarChar(20)
  PaymentTypeMufg    String? @db.VarChar(30)
  ExchangeMethod     String? @db.VarChar(30)
  RemittanceNote1    String? @db.VarChar(500)
  RemittanceNote2    String? @db.VarChar(500)

  @@unique([BpId, BankId, AccountNo])
