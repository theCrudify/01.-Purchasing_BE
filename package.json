{
  "name": "purchasing-be",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "deploy:cf": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:reset": "./db/reset-local.sh",
    "db:validate": "prisma validate --schema db/prisma/schema.prisma",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel db/prisma/schema.prisma --script",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.21",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0",
    "@hono/node-server": "^1.19.0",
    "prisma": "^6.19.0"
  },
  "main": "src/index.ts"
}